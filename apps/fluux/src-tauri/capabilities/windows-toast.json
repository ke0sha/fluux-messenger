{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "windows-toast",
  "description": "Restricted permissions for the small notification popup",
  "platforms": ["windows"],
  "windows": ["fluux-toast-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:event:allow-emit-to"
  ]
}
